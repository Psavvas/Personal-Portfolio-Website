---
import MarkdownEditor from '../../components/admin/MarkdownEditor.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  adminGetNowMarkdown,
  adminSaveNowMarkdown,
} from '../../lib/site-content';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    await adminSaveNowMarkdown(String(form.get('bodyMd') ?? ''));
    return Astro.redirect('/admin/now?saved=1');
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

const bodyMd = await adminGetNowMarkdown();
const saved = Astro.url.searchParams.has('saved');
---

<AdminLayout title="Now section">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1
        class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        "Now" section
      </h1>
      <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
        This text appears in the "Now" section of the About page. If it is
        empty, the page falls back to its built-in copy.
      </p>
    </div>
    <a
      href="/about"
      target="_blank"
      rel="noopener noreferrer"
      class="site-btn site-btn--sm hover-lift"
    >
      View About page ↗
    </a>
  </header>

  {
    saved && (
      <div class="mt-6 rounded-lg border border-emerald-300 bg-emerald-50 p-3 text-sm text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
        Now section saved.
      </div>
    )
  }

  {
    error && (
      <div class="mt-6 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
        {error}
      </div>
    )
  }

  <form method="post" class="mt-8 space-y-6">
    <MarkdownEditor
      name="bodyMd"
      label="Content (Markdown)"
      value={bodyMd}
      rows={12}
    />
    <button type="submit" class="site-btn hover-lift">Save</button>
  </form>
</AdminLayout>
