---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import {
  getPublishedBlogPosts,
  getBlogPostBySlug,
} from '../../lib/notion-blog';
import { getPublishedProjects } from '../../lib/notion-projects';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post: entry } = Astro.props;
if (!entry || !entry.slug) {
  throw new Error('Blog post not found');
}

const post = await getBlogPostBySlug(entry.slug);
if (!post) {
  throw new Error(`Blog post not found for slug: ${entry.slug}`);
}

const projects = await getPublishedProjects();
const featuredProject = post.featuredProjectSlug
  ? projects.find((project) => project.slug === post.featuredProjectSlug)
  : undefined;
---

<BaseLayout title={`${post.title} | Paul Savvas`} description={post.summary}>
  <ReadingProgress />

  <article class="mx-auto w-full max-w-3xl px-6 pt-32 pb-24 sm:px-10 sm:pt-36">
    <a
      href="/blog"
      class="group inline-flex items-center gap-1.5 text-sm font-medium text-ink-tertiary transition-colors hover:text-ink"
      data-reveal
    >
      <span
        class="transition-transform duration-300 group-hover:-translate-x-1"
        aria-hidden="true">←</span
      >
      Back to Blog
    </a>

    <header class="mt-10" data-reveal style="--reveal-delay: 80ms">
      <time class="text-sm text-ink-tertiary" datetime={post.date}>
        {formatDate(post.date)}
      </time>
      <h1 class="display mt-3 text-4xl sm:text-5xl">{post.title}</h1>
      <p class="mt-6 text-lg leading-8 text-ink-secondary">{post.summary}</p>

      {
        post.tags && post.tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {post.tags.map((tag: string) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        )
      }

      {
        featuredProject && (
          <aside class="card card-interactive mt-10">
            <a
              href={`/projects/${featuredProject.slug}`}
              class="group flex items-center gap-4 p-5 no-underline sm:p-6"
            >
              <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-hairline bg-subtle text-ink">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 7.5 12 3l9 4.5-9 4.5-9-4.5Zm0 4.5 9 4.5 9-4.5M3 16.5 12 21l9-4.5"
                  />
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="eyebrow block">Featured project</span>
                <span class="mt-1 block truncate text-[0.95rem] font-semibold tracking-tight text-ink">
                  {featuredProject.title}
                </span>
              </span>
              <span
                class="shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </aside>
        )
      }
    </header>

    <div
      class="prose prose-neutral dark:prose-invert mt-12 max-w-none"
      data-reveal
      style="--reveal-delay: 160ms"
      set:html={post.bodyHtml ?? ''}
    />
  </article>
</BaseLayout>
