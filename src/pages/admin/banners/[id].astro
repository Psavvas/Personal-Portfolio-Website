---
import BannerForm from '../../../components/admin/BannerForm.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  friendlyDbError,
  parseBannerForm,
  readBannerForm,
} from '../../../lib/admin-forms';
import {
  adminGetBanner,
  adminUpdateBanner,
  type BannerInput,
} from '../../../lib/banners';
import { getSitePageGroups } from '../../../lib/site-pages';

const id = Astro.params.id ?? '';
let error = '';
let overrides: Partial<BannerInput> | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    const input = parseBannerForm(form);
    await adminUpdateBanner(id, input);
    return Astro.redirect('/admin/banners?saved=1');
  } catch (err) {
    error = friendlyDbError(err);
    overrides = readBannerForm(form);
  }
}

const banner = await adminGetBanner(id).catch(() => undefined);
if (!banner) {
  return Astro.redirect('/admin/banners');
}

const values: Partial<BannerInput> = {
  bodyMd: banner.bodyMd,
  color: banner.color,
  scope: banner.scope,
  paths: banner.paths,
  active: banner.active,
  sortOrder: banner.sortOrder,
  ...(overrides ?? {}),
};

const pageGroups = await getSitePageGroups();
---

<AdminLayout title="Edit banner">
  <header>
    <a
      href="/admin/banners"
      class="text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
    >
      ← Back to banners
    </a>
    <h1
      class="mt-3 text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
    >
      Edit banner
    </h1>
  </header>

  {
    error && (
      <div class="mt-6 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
        {error}
      </div>
    )
  }

  <div class="mt-8">
    <BannerForm
      values={values}
      pageGroups={pageGroups}
      submitLabel="Save changes"
    />
  </div>
</AdminLayout>
