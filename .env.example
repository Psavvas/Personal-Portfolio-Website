# Neon Postgres connection string.
# Neon console (https://console.neon.tech) → your project → "Connection string".
# Use the pooled connection string if offered.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign admin sessions. Generate a long random value:
#   openssl rand -base64 32
# Must be at least 32 characters; placeholder values are rejected at startup so
# the portal can't quietly boot on a guessable secret. Changing it signs every
# device out.
BETTER_AUTH_SECRET=

# The canonical origin of the deployed site. Set this in your Vercel
# *production* environment and leave it unset everywhere else, so preview
# deployments keep inferring their own origin.
#
# Pinning it is what makes the admin portal's cross-origin check meaningful:
# without it the expected origin is derived from the Host header, which anyone
# can set on the *.vercel.app deployment URL.
# BETTER_AUTH_URL=https://paulsavvas.com

# Optional: enables image uploads from the admin Markdown editor.
# UploadThing dashboard (https://uploadthing.com/dashboard) → API Keys.
# UPLOADTHING_TOKEN=
