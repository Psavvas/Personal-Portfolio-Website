---
/**
 * Lightweight, dependency-free search/filter input.
 *
 * It filters elements marked with `[data-search]` inside the container with
 * `id={targetId}`, matching against the lowercase text stored in each item's
 * `data-search` attribute. All filtering happens client-side over content that
 * is already server-rendered, so there is no extra data fetch and the page
 * stays fast.
 */
interface Props {
  /** id of the container whose `[data-search]` children should be filtered */
  targetId: string;
  /** Accessible label for the input (visually hidden) */
  label: string;
  placeholder?: string;
  /** id of an element to reveal when no items match */
  emptyId?: string;
  /** id of an element to receive a live "X of Y" result count */
  countId?: string;
  /** extra classes for the wrapper */
  class?: string;
}

const {
  targetId,
  label,
  placeholder = 'Search…',
  emptyId,
  countId,
  class: className = '',
} = Astro.props;

const inputId = `${targetId}-search`;
---

<div class={`relative ${className}`}>
  <label for={inputId} class="sr-only">{label}</label>
  <svg
    class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400 dark:text-neutral-500"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"></path>
  </svg>
  <input
    id={inputId}
    type="search"
    placeholder={placeholder}
    autocomplete="off"
    aria-controls={targetId}
    data-search-input
    data-target={targetId}
    data-empty={emptyId ?? ''}
    data-count={countId ?? ''}
    class="w-full rounded-lg border border-neutral-200 bg-white py-2.5 pl-10 pr-4 text-sm text-neutral-900 transition-colors placeholder:text-neutral-400 focus:border-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-200 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-100 dark:placeholder:text-neutral-500 dark:focus:border-neutral-600 dark:focus:ring-neutral-800"
  />
</div>

<script>
  function setHidden(el: HTMLElement, hide: boolean) {
    // Set both the attribute (so Tailwind's `divide-y` skips it and it's
    // hidden from assistive tech) and an inline style (which reliably wins
    // over display utilities such as `flex` on the item itself).
    el.toggleAttribute('hidden', hide);
    el.style.display = hide ? 'none' : '';
  }

  function setupSearch(input: HTMLInputElement) {
    const targetId = input.getAttribute('data-target');
    if (!targetId) return;

    const container = document.getElementById(targetId);
    if (!container) return;

    const emptyId = input.getAttribute('data-empty');
    const countId = input.getAttribute('data-count');
    const empty = emptyId ? document.getElementById(emptyId) : null;
    const count = countId ? document.getElementById(countId) : null;
    const items = Array.from(
      container.querySelectorAll<HTMLElement>('[data-search]')
    );

    function apply() {
      const terms = input.value
        .toLowerCase()
        .trim()
        .split(/\s+/)
        .filter(Boolean);

      let visible = 0;
      for (const item of items) {
        const haystack = item.getAttribute('data-search') || '';
        const match = terms.every((term) => haystack.includes(term));
        setHidden(item, !match);
        if (match) visible += 1;
      }

      if (empty) empty.classList.toggle('hidden', visible !== 0);
      if (count) {
        count.textContent =
          terms.length === 0 ? '' : `${visible} of ${items.length}`;
      }
    }

    input.addEventListener('input', apply);
    apply();
  }

  document
    .querySelectorAll<HTMLInputElement>('[data-search-input]')
    .forEach(setupSearch);
</script>
