# Neon Postgres connection string.
# Neon console (https://console.neon.tech) → your project → "Connection string".
# Use the pooled connection string if offered.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign admin sessions. Generate a long random value, e.g.
#   openssl rand -base64 32
# Changing it signs every device out.
BETTER_AUTH_SECRET=change-me

# One-time key that authorises creating the owner account at /admin/setup.
# Only needed until that account exists; you can delete it afterwards.
ADMIN_SETUP_KEY=change-me-too

# Optional: pin the auth origin to a single URL. Leave unset to infer it from
# the incoming request (keeps Vercel preview deployments working).
# BETTER_AUTH_URL=https://paulsavvas.com

# Optional: enables image uploads from the admin Markdown editor.
# UploadThing dashboard (https://uploadthing.com/dashboard) → API Keys.
# UPLOADTHING_TOKEN=
