---
import ProjectForm from '../../../components/admin/ProjectForm.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminListBlogPosts } from '../../../lib/blog';
import {
  friendlyDbError,
  parseProjectForm,
  readProjectForm,
} from '../../../lib/admin-forms';
import { adminCreateProject, type ProjectInput } from '../../../lib/projects';

let error = '';
let values: Partial<ProjectInput> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    const input = parseProjectForm(form);
    values = input;
    await adminCreateProject(input);
    return Astro.redirect('/admin/projects?saved=1');
  } catch (err) {
    error = friendlyDbError(err);
    // Keep everything the user just submitted, including checkboxes.
    values = readProjectForm(form);
  }
}

// The slug dropdown is a convenience — render the form even if the DB is
// unreachable (saving will surface the real error).
const blogSlugs = await adminListBlogPosts()
  .then((posts) => posts.map((post) => post.slug))
  .catch(() => [] as string[]);
---

<AdminLayout title="New project">
  <header>
    <a
      href="/admin/projects"
      class="text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
    >
      ← Back to projects
    </a>
    <h1
      class="mt-3 text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
    >
      New project
    </h1>
  </header>

  {
    error && (
      <div class="mt-6 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
        {error}
      </div>
    )
  }

  <div class="mt-8">
    <ProjectForm
      values={values}
      blogSlugs={blogSlugs}
      submitLabel="Create project"
    />
  </div>
</AdminLayout>
