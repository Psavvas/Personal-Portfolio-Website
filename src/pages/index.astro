---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const blogPosts = await getCollection('blog');

function slugFromId(id: string) {
  return id.replace(/\.mdx?$/, '');
}

function getProjectYear(project: (typeof projects)[number]): number {
  const year = project.data.year;
  if (!year) return 0;
  if (Array.isArray(year)) {
    return year
      .map((value) => Number(value))
      .filter((value) => !Number.isNaN(value))
      .reduce((max, value) => Math.max(max, value), 0);
  }
  const parsed = Number(year);
  return Number.isNaN(parsed) ? 0 : parsed;
}

const latestProject = projects
  .slice()
  .sort((a, b) => getProjectYear(b) - getProjectYear(a))[0];
const latestPost = blogPosts
  .slice()
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )[0];
const projectCount = projects.length;
const blogCount = blogPosts.length;
---

<BaseLayout
  title="Paul Savvas"
  description="Paul Savvas — student engineer who builds practical tools across software, hardware, and 3D design."
>
  <main class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <section class="grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-start">
      <div class="animate-fade-in-up">
        <p
          class="text-sm font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400"
        >
          Student Engineer · Builder
        </p>
        <h1
          class="mt-4 text-4xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-5xl"
        >
          Clean, practical projects across software, hardware, and 3D design.
        </h1>
        <p
          class="mt-6 max-w-2xl text-base leading-7 text-neutral-700 dark:text-neutral-300"
        >
          I'm Paul Savvas, a STEM Academy student building tools that are simple
          to understand and reliable in real use. I focus on thoughtful
          engineering, clear communication, and measurable outcomes.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="inline-flex items-center justify-center rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200"
            href="/projects"
          >
            View projects
          </a>
          <a
            class="inline-flex items-center justify-center rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-900 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-100 dark:hover:bg-neutral-900"
            href="/blog"
          >
            Read blog
          </a>
          <a
            class="inline-flex items-center justify-center rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-900 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-100 dark:hover:bg-neutral-900"
            href="/contact"
          >
            Contact me
          </a>
        </div>
      </div>

      <aside
        class="animate-fade-in-up rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950"
      >
        <h2
          class="text-base font-semibold text-neutral-900 dark:text-neutral-100"
        >
          Latest updates
        </h2>
        <dl class="mt-5 space-y-4 text-sm">
          <div>
            <dt class="text-neutral-500 dark:text-neutral-400">
              Latest project
            </dt>
            <dd class="mt-1">
              {
                latestProject ? (
                  <a
                    href={`/projects/${slugFromId(latestProject.id)}`}
                    class="font-medium text-neutral-900 underline decoration-neutral-300 underline-offset-4 hover:decoration-neutral-900 dark:text-neutral-100 dark:decoration-neutral-700 dark:hover:decoration-neutral-100"
                  >
                    {latestProject.data.title}
                  </a>
                ) : (
                  <span class="text-neutral-700 dark:text-neutral-300">
                    New project coming soon
                  </span>
                )
              }
            </dd>
          </div>
          <div>
            <dt class="text-neutral-500 dark:text-neutral-400">
              Latest blog post
            </dt>
            <dd class="mt-1">
              {
                latestPost ? (
                  <a
                    href={`/blog/${slugFromId(latestPost.id)}`}
                    class="font-medium text-neutral-900 underline decoration-neutral-300 underline-offset-4 hover:decoration-neutral-900 dark:text-neutral-100 dark:decoration-neutral-700 dark:hover:decoration-neutral-100"
                  >
                    {latestPost.data.title}
                  </a>
                ) : (
                  <span class="text-neutral-700 dark:text-neutral-300">
                    New post coming soon
                  </span>
                )
              }
            </dd>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-1">
            <div
              class="rounded-lg border border-neutral-200 px-3 py-2 dark:border-neutral-800"
            >
              <dt class="text-neutral-500 dark:text-neutral-400">Projects</dt>
              <dd
                class="mt-1 font-medium text-neutral-900 dark:text-neutral-100"
              >
                {projectCount}
              </dd>
            </div>
            <div
              class="rounded-lg border border-neutral-200 px-3 py-2 dark:border-neutral-800"
            >
              <dt class="text-neutral-500 dark:text-neutral-400">Posts</dt>
              <dd
                class="mt-1 font-medium text-neutral-900 dark:text-neutral-100"
              >
                {blogCount}
              </dd>
            </div>
          </div>
        </dl>
      </aside>
    </section>

    <section class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <article
        class="animate-fade-in-up rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950"
      >
        <h3
          class="text-base font-semibold text-neutral-900 dark:text-neutral-100"
        >
          Software
        </h3>
        <p
          class="mt-2 text-sm leading-6 text-neutral-700 dark:text-neutral-300"
        >
          Utilities and web tools with clear architecture and maintainable code.
        </p>
      </article>
      <article
        class="animate-fade-in-up rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950"
      >
        <h3
          class="text-base font-semibold text-neutral-900 dark:text-neutral-100"
        >
          Hardware
        </h3>
        <p
          class="mt-2 text-sm leading-6 text-neutral-700 dark:text-neutral-300"
        >
          Projects that balance electronics, sensing, and practical constraints.
        </p>
      </article>
      <article
        class="animate-fade-in-up rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950 sm:col-span-2 lg:col-span-1"
      >
        <h3
          class="text-base font-semibold text-neutral-900 dark:text-neutral-100"
        >
          3D Design
        </h3>
        <p
          class="mt-2 text-sm leading-6 text-neutral-700 dark:text-neutral-300"
        >
          Prototypes and printable parts refined through iterative testing.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>
