---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatProjectYear, getProjectBySlug } from '../../lib/projects';
import { getPublishedBlogPosts } from '../../lib/blog';

const slug = Astro.params.slug;
const entry = slug ? await getProjectBySlug(slug) : undefined;

if (!entry) {
  return Astro.redirect('/404');
}

const blogPosts = await getPublishedBlogPosts();

let featuredPost: { title: string; slug: string } | undefined;
if (entry.featuredBlog) {
  const match = blogPosts.find((p) => p.slug === entry.featuredBlog);
  if (match) {
    featuredPost = { title: match.title, slug: match.slug };
  }
}

const yr = formatProjectYear(entry.year);
const tagCls =
  'inline-flex items-center rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700 dark:bg-neutral-900 dark:text-neutral-300';
---

<BaseLayout title={`${entry.title} | Paul Savvas`} description={entry.summary}>
  <div
    class="min-h-screen bg-white font-sans dark:bg-neutral-950 transition-colors"
  >
    <main
      class="mx-auto w-full max-w-6xl bg-white px-6 py-16 dark:bg-neutral-950 sm:px-16 sm:py-24 animate-fade-in"
    >
      <div class="w-full">
        <a
          href="/projects"
          class="inline-flex items-center text-sm font-medium text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 animate-slide-in-left"
        >
          ← Back to Projects
        </a>

        <header class="mt-8 animate-fade-in-up">
          {
            yr && (
              <p class="text-sm text-neutral-600 dark:text-neutral-400">{yr}</p>
            )
          }
          <h1
            class="mt-3 text-4xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-5xl"
          >
            {entry.title}
          </h1>
          <p
            class="mt-6 text-base leading-7 text-neutral-700 dark:text-neutral-300"
          >
            {entry.summary}
          </p>

          {
            entry.tags && entry.tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {entry.tags.map((t: string) => (
                  <span class={tagCls}>{t}</span>
                ))}
              </div>
            )
          }

          {
            entry.aiBuilt && (
              <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-600 dark:text-neutral-400">
                <span class="inline-flex items-center gap-1 rounded-full border border-violet-200 bg-violet-50 px-2.5 py-0.5 text-[11px] font-medium text-violet-700 dark:border-violet-900 dark:bg-violet-950/60 dark:text-violet-300">
                  ✦ Built with AI
                </span>
                <span>
                  This project was built entirely with AI — I provided the
                  direction, iteration, and testing; AI wrote the code.
                </span>
              </p>
            )
          }

          {entry.topLinksHtml && <div set:html={entry.topLinksHtml} />}

          {
            featuredPost && (
              <aside class="mt-10 rounded-xl border border-neutral-200 bg-neutral-50/80 p-6 dark:border-neutral-800 dark:bg-neutral-900/60">
                <div class="flex items-center gap-4">
                  <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-neutral-200/80 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      class="h-6 w-6"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.5 6.75A2.25 2.25 0 0 1 6.75 4.5h10.5A2.25 2.25 0 0 1 19.5 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 17.25V6.75Zm3.75 2.25h7.5M8.25 12h7.5M8.25 15h4.5"
                      />
                    </svg>
                  </span>
                  <div class="min-w-0">
                    <p class="text-xs font-medium uppercase tracking-[0.08em] text-neutral-600 dark:text-neutral-300">
                      Featured Blog Post
                    </p>
                    <a
                      href={`/blog/${featuredPost.slug}`}
                      class="mt-1 inline-flex items-center gap-2 text-sm font-medium tracking-tight text-neutral-900 hover:text-neutral-700 dark:text-neutral-100 dark:hover:text-neutral-300"
                    >
                      <span class="truncate">{featuredPost.title}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </aside>
            )
          }
        </header>

        <article
          class="mt-10 space-y-5 animate-fade-in-up prose prose-neutral dark:prose-invert max-w-none prose-headings:font-semibold prose-headings:tracking-tight"
          set:html={entry.bodyHtml ?? ''}
        />
      </div>
    </main>
  </div>
</BaseLayout>
