---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import {
  formatProjectYear,
  getProjectBySlug,
  getPublishedProjectPages,
} from '../../lib/notion-projects';
import { getPublishedBlogPosts } from '../../lib/notion-blog';

export async function getStaticPaths() {
  const entries = await getPublishedProjectPages();
  return entries.map((entry) => ({
    params: { slug: entry.slug as string },
  }));
}

const slug = Astro.params.slug;
const entry = slug ? await getProjectBySlug(slug) : undefined;

if (!entry) {
  throw new Error(`Project not found for slug: ${slug}`);
}

const blogPosts = await getPublishedBlogPosts();

let featuredPost: { title: string; slug: string } | undefined;
if (entry.featuredBlog) {
  const match = blogPosts.find((p) => p.slug === entry.featuredBlog);
  if (match) {
    featuredPost = { title: match.title, slug: match.slug };
  }
}

const year = formatProjectYear(entry.year);
---

<BaseLayout title={`${entry.title} | Paul Savvas`} description={entry.summary}>
  <ReadingProgress />

  <article class="mx-auto w-full max-w-3xl px-6 pt-32 pb-24 sm:px-10 sm:pt-36">
    <a
      href="/projects"
      class="group inline-flex items-center gap-1.5 text-sm font-medium text-ink-tertiary transition-colors hover:text-ink"
      data-reveal
    >
      <span
        class="transition-transform duration-300 group-hover:-translate-x-1"
        aria-hidden="true">←</span
      >
      Back to Projects
    </a>

    <header class="mt-10" data-reveal style="--reveal-delay: 80ms">
      {year && <p class="text-sm text-ink-tertiary">{year}</p>}
      <h1 class="display mt-3 text-4xl sm:text-5xl">{entry.title}</h1>
      <p class="mt-6 text-lg leading-8 text-ink-secondary">{entry.summary}</p>

      {
        entry.tags && entry.tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {entry.tags.map((tag: string) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        )
      }

      {entry.topLinksHtml && <div set:html={entry.topLinksHtml} />}

      {
        featuredPost && (
          <aside class="card card-interactive mt-10">
            <a
              href={`/blog/${featuredPost.slug}`}
              class="group flex items-center gap-4 p-5 no-underline sm:p-6"
            >
              <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-hairline bg-subtle text-ink">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 18V6A1.5 1.5 0 0 1 5 4.5Zm3 4h8m-8 4h8m-8 4h5"
                  />
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="eyebrow block">Featured blog post</span>
                <span class="mt-1 block truncate text-[0.95rem] font-semibold tracking-tight text-ink">
                  {featuredPost.title}
                </span>
              </span>
              <span
                class="shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </aside>
        )
      }
    </header>

    <div
      class="prose prose-neutral dark:prose-invert mt-12 max-w-none"
      data-reveal
      style="--reveal-delay: 160ms"
      set:html={entry.bodyHtml ?? ''}
    />
  </article>
</BaseLayout>
