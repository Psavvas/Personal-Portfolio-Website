---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedBlogPosts } from '../../lib/notion-blog';
import { formatDate } from '../../lib/format';

const pageTitle = 'Blog | Paul Savvas';
const pageDesc =
  'Blog posts by Paul Savvas — project notes, lessons learned, and build write-ups.';

const sortedPosts = await getPublishedBlogPosts();
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="mx-auto w-full max-w-4xl px-6 pt-32 pb-24 sm:px-10 sm:pt-36">
    {/* ── Header ── */}
    <header class="max-w-2xl" data-reveal>
      <p class="eyebrow">Blog</p>
      <h1 class="display mt-4 text-4xl sm:text-6xl">
        Notes &amp; <span class="text-gradient">write-ups.</span>
      </h1>
      <p class="mt-6 text-base leading-8 text-ink-secondary sm:text-lg">
        Short posts about projects, engineering decisions, and what I learn
        while building.
      </p>
    </header>

    {/* ── Posts ── */}
    <section class="mt-16">
      {
        sortedPosts.length === 0 ? (
          <div class="card p-8" data-reveal>
            <h2 class="text-lg font-semibold tracking-tight text-ink">
              Coming soon
            </h2>
            <p class="mt-3 text-sm leading-6 text-ink-secondary">
              I'm working on the first set of posts now.
            </p>
          </div>
        ) : (
          <ul class="space-y-5">
            {sortedPosts.map((post, index) => (
              <li
                data-reveal
                style={`--reveal-delay: ${Math.min(index, 4) * 70}ms`}
              >
                <a
                  href={`/blog/${post.slug}`}
                  class="card card-interactive group block p-7 no-underline sm:p-8"
                >
                  <div class="flex items-center gap-3 text-sm text-ink-tertiary">
                    <time datetime={post.date}>{formatDate(post.date)}</time>
                    {post.tags && post.tags.length > 0 && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span class="flex flex-wrap gap-2">
                          {post.tags.map((tag) => (
                            <span class="chip">{tag}</span>
                          ))}
                        </span>
                      </>
                    )}
                  </div>
                  <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink">
                    {post.title}
                  </h2>
                  <p class="mt-3 line-clamp-2 text-[0.95rem] leading-7 text-ink-secondary">
                    {post.summary}
                  </p>
                  <p class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                    Read post
                    <span
                      class="transition-transform duration-300 group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</BaseLayout>
