---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotionRedirectMap } from '../../lib/notion-redirects';

export async function getStaticPaths() {
  const redirects = await getNotionRedirectMap();

  return Object.keys(redirects).map((key) => ({
    params: { slug: key },
  }));
}

const { slug } = Astro.params;
const redirects = await getNotionRedirectMap();
const destination = slug ? redirects[slug] : undefined;

if (!destination) {
  return Astro.redirect('/404');
}

// Determine if it's an internal or external link
const isInternal = destination.startsWith('/');
const linkType = isInternal ? 'internal page' : 'external site';
---

<BaseLayout title={`Redirecting... | Paul Savvas`}>
  <div
    class="mx-auto flex min-h-[88svh] w-full max-w-3xl flex-col items-center justify-center gap-6 px-6 pt-32 pb-24 text-center sm:px-10"
  >
    <!-- Loading indicator -->
    <div
      class="h-12 w-12 animate-spin rounded-full border-4 border-hairline border-t-accent"
      aria-hidden="true"
    >
    </div>

    <p class="eyebrow">Redirecting</p>

    <h1 class="display text-3xl sm:text-4xl">
      Taking you to your destination...
    </h1>

    <p class="max-w-md text-base leading-7 text-ink-secondary">
      You're being redirected to an {linkType}. If you're not redirected
      automatically, click the button below.
    </p>

    <div class="mt-2">
      <a href={destination} class="btn btn-primary">
        Continue to destination
        <svg
          class="btn-arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14m0 0-5-5m5 5-5 5"></path>
        </svg>
      </a>
    </div>

    <p class="text-xs text-ink-tertiary">
      Destination: <code class="rounded bg-subtle px-1.5 py-0.5"
        >{destination}</code
      >
    </p>
  </div>

  <!-- Auto-redirect script -->
  <script is:inline data-destination={destination}>
    // Redirect after a brief delay to allow users to see the page
    const REDIRECT_DELAY_MS = 1500;

    // Destination is controlled server-side via Notion database
    const scriptElement = document.currentScript;
    const redirectTo = scriptElement?.dataset.destination;

    if (redirectTo) {
      window.setTimeout(() => {
        window.location.replace(redirectTo);
      }, REDIRECT_DELAY_MS);
    }
  </script>
</BaseLayout>
