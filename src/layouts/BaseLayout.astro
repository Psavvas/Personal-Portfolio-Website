---
import '../styles/globals.css';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Paul Savvas — student engineer building practical tools across software, hardware, and 3D design.',
} = Astro.props;

const siteUrl = 'https://paulsavvas.me';
const fullTitle = title.includes('Paul Savvas')
  ? title
  : `${title} | Paul Savvas`;

const navEntries = [
  { label: 'Home', path: '/' },
  { label: 'About', path: '/about' },
  { label: 'Projects', path: '/projects' },
  { label: 'Blog', path: '/blog' },
  { label: 'Contact', path: '/contact' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath.startsWith(path);

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/psavvas' },
  { label: 'Thingiverse', href: 'https://www.thingiverse.com/psavvas' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/pauldsavvas' },
  { label: 'Gravatar', href: 'https://gravatar.com/psavvas' },
];

const currentYear = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fbfbfd"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000000"
    />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="Paul Savvas" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Inter variable font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap"
    />

    <ClientRouter />
    <Analytics />

    {
      /* Inline theme initialisation — runs before paint to avoid flash.
        Re-applied after view transitions because <html> attributes are
        replaced during the swap. */
    }
    <script is:inline>
      (function () {
        var root = document.documentElement;

        function applyStoredTheme() {
          var stored = localStorage.getItem('ps-theme');
          var prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches;
          var useDark =
            stored === 'dark' || (stored !== 'light' && prefersDark);
          root.classList.toggle('dark', useDark);
        }

        function markEnhanced() {
          root.classList.add('js');
        }

        applyStoredTheme();
        markEnhanced();

        // Navbar entrance animation — only on first site load in this session
        if (!sessionStorage.getItem('ps-visited')) {
          root.classList.add('navbar-animate');
          sessionStorage.setItem('ps-visited', '1');
        }

        document.addEventListener('astro:after-swap', function () {
          applyStoredTheme();
          markEnhanced();
          root.classList.add('theme-transitions');
        });
      })();
    </script>
  </head>

  <body class="bg-canvas font-sans text-ink antialiased">
    <div class="ambient" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to content</a>

    {/* ── Navbar ── */}
    <header id="site-nav" class="site-nav glass">
      <nav
        class="flex items-center justify-between gap-2 py-1.5 pr-1.5 pl-4 sm:py-2 sm:pr-2"
        aria-label="Primary"
      >
        <a
          href="/"
          class="flex shrink-0 items-center gap-2.5 text-[0.95rem] font-semibold tracking-tight text-ink"
        >
          <span
            class="h-2 w-2 rounded-full"
            style="background: var(--gradient-display);"
            aria-hidden="true"></span>
          Paul Savvas
        </a>

        <ul class="hidden items-center gap-0.5 md:flex">
          {
            navEntries.map((entry) => (
              <li>
                <a
                  href={entry.path}
                  class="nav-link"
                  aria-current={isActive(entry.path) ? 'page' : undefined}
                >
                  {entry.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="flex items-center gap-1.5">
          {/* Search — full button on ≥sm, icon-only on small screens */}
          <button
            type="button"
            class="nav-search-btn hidden sm:inline-flex"
            data-search-open
            aria-label="Search the site"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
              ></path>
            </svg>
            <span class="pr-1">Search</span>
            <kbd data-kbd-hint>⌘K</kbd>
          </button>
          <button
            type="button"
            class="nav-icon-btn sm:hidden"
            data-search-open
            aria-label="Search the site"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-[1.15rem] w-[1.15rem]"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
              ></path>
            </svg>
          </button>

          {/* Theme toggle: light → dark → system */}
          <button
            type="button"
            class="nav-icon-btn"
            data-theme-toggle
            aria-label="Toggle colour theme"
          >
            <svg
              class="h-[1.15rem] w-[1.15rem]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                data-theme-icon="light"
                class="hidden"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"
              ></path>
              <path
                data-theme-icon="dark"
                class="hidden"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20.354 15.354A9 9 0 0 1 8.646 3.646 9.003 9.003 0 0 0 12 21a9.003 9.003 0 0 0 8.354-5.646Z"
              ></path>
              <path
                data-theme-icon="system"
                class="hidden"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.75 17 9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z"
              ></path>
            </svg>
          </button>

          {/* Mobile menu toggle */}
          <button
            type="button"
            class="nav-icon-btn md:hidden"
            data-menu-toggle
            aria-label="Open navigation menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <svg
              class="h-[1.15rem] w-[1.15rem]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                data-menu-icon="open"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 7h16M4 12h16M4 17h16"></path>
              <path
                data-menu-icon="close"
                class="hidden"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    {/* ── Mobile menu ── */}
    <div id="mobile-menu" class="mobile-menu glass p-2 md:hidden">
      {
        navEntries.map((entry) => (
          <a
            href={entry.path}
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-[0.95rem] font-medium text-ink-secondary hover:bg-subtle hover:text-ink"
            aria-current={isActive(entry.path) ? 'page' : undefined}
          >
            {entry.label}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-4 w-4 opacity-40"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m9 18 6-6-6-6"
              />
            </svg>
          </a>
        ))
      }
    </div>

    {/* ── Page content ── */}
    <main id="main">
      <slot />
    </main>

    {/* ── Footer ── */}
    <footer class="border-t border-hairline">
      <div class="mx-auto w-full max-w-6xl px-6 py-14 sm:px-10">
        <div
          class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between"
        >
          <div class="max-w-xs">
            <a
              href="/"
              class="flex items-center gap-2.5 text-[0.95rem] font-semibold tracking-tight text-ink"
            >
              <span
                class="h-2 w-2 rounded-full"
                style="background: var(--gradient-display);"
                aria-hidden="true"></span>
              Paul Savvas
            </a>
            <p class="mt-3 text-sm leading-6 text-ink-tertiary">
              Student engineer building practical tools across software,
              hardware, and 3D design.
            </p>
          </div>

          <div class="flex gap-16">
            <div>
              <p class="eyebrow">Explore</p>
              <ul class="mt-4 space-y-2.5">
                {
                  navEntries.map((entry) => (
                    <li>
                      <a
                        href={entry.path}
                        class="text-sm text-ink-secondary transition-colors hover:text-ink"
                      >
                        {entry.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <p class="eyebrow">Elsewhere</p>
              <ul class="mt-4 space-y-2.5">
                {
                  socialLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm text-ink-secondary transition-colors hover:text-ink"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <div
          class="mt-12 flex flex-col gap-3 border-t border-hairline pt-6 text-sm text-ink-tertiary sm:flex-row sm:items-center sm:justify-between"
        >
          <span>&copy; {currentYear} Paul Savvas. All rights reserved.</span>
          <div class="flex items-center gap-4">
            <a
              href="https://paulsavvas.instatus.com"
              class="transition-colors hover:text-ink"
              target="_blank"
              rel="noopener noreferrer"
            >
              Status
            </a>
            <a
              href="https://astro.build"
              class="transition-colors hover:text-ink"
              target="_blank"
              rel="noopener noreferrer"
            >
              Built with Astro
            </a>
          </div>
        </div>
      </div>
    </footer>

    <CommandPalette />

    {
      /* Global interactions: theme toggle, mobile menu, scroll state,
        active nav links, and scroll-triggered reveals. Listeners are
        delegated to `document` and bound exactly once so they survive
        view-transition page swaps. */
    }
    <script>
      const THEME_KEY = 'ps-theme';
      const MODES = ['light', 'dark', 'system'];

      function currentMode(): string {
        return localStorage.getItem(THEME_KEY) || 'system';
      }

      function applyMode(mode: string) {
        const prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches;
        document.documentElement.classList.toggle(
          'dark',
          mode === 'dark' || (mode === 'system' && prefersDark)
        );
      }

      function refreshThemeIcons() {
        const mode = currentMode();
        document
          .querySelectorAll<HTMLElement>('[data-theme-icon]')
          .forEach((icon) => {
            icon.classList.toggle('hidden', icon.dataset.themeIcon !== mode);
          });
      }

      function menuButton() {
        return document.querySelector<HTMLElement>('[data-menu-toggle]');
      }

      function isMenuOpen() {
        return (
          document
            .getElementById('mobile-menu')
            ?.classList.contains('is-open') ?? false
        );
      }

      function setMenuOpen(open: boolean) {
        const menu = document.getElementById('mobile-menu');
        const button = menuButton();
        if (!menu || !button) return;

        menu.classList.toggle('is-open', open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute(
          'aria-label',
          open ? 'Close navigation menu' : 'Open navigation menu'
        );
        button
          .querySelector('[data-menu-icon="open"]')
          ?.classList.toggle('hidden', open);
        button
          .querySelector('[data-menu-icon="close"]')
          ?.classList.toggle('hidden', !open);
      }

      function syncNavScrollState() {
        document
          .getElementById('site-nav')
          ?.classList.toggle('is-scrolled', window.scrollY > 8);
      }

      function syncPlatformHints() {
        const isApplePlatform = /Mac|iPhone|iPad|iPod/.test(
          navigator.platform || navigator.userAgent
        );
        document
          .querySelectorAll<HTMLElement>('[data-kbd-hint]')
          .forEach((kbd) => {
            kbd.textContent = isApplePlatform ? '⌘K' : 'Ctrl K';
          });
      }

      function setupReveals() {
        const existing = (window as any).__psRevealObserver as
          | IntersectionObserver
          | undefined;
        existing?.disconnect();

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
        );

        document
          .querySelectorAll('[data-reveal]:not(.is-revealed)')
          .forEach((el) => observer.observe(el));
        (window as any).__psRevealObserver = observer;
      }

      function onPageReady() {
        refreshThemeIcons();
        syncNavScrollState();
        syncPlatformHints();
        setupReveals();
      }

      if (!(window as any).__psLayoutBound) {
        (window as any).__psLayoutBound = true;

        document.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;

          if (target.closest('[data-theme-toggle]')) {
            const next =
              MODES[(MODES.indexOf(currentMode()) + 1) % MODES.length];
            localStorage.setItem(THEME_KEY, next);
            applyMode(next);
            refreshThemeIcons();
            return;
          }

          if (target.closest('[data-menu-toggle]')) {
            setMenuOpen(!isMenuOpen());
            return;
          }

          if (target.closest('#mobile-menu a')) {
            setMenuOpen(false);
            return;
          }

          if (isMenuOpen() && !target.closest('#mobile-menu')) {
            setMenuOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenuOpen(false);
        });

        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', () => applyMode(currentMode()));

        window.addEventListener('scroll', syncNavScrollState, {
          passive: true,
        });

        document.addEventListener('astro:page-load', onPageReady);

        window.requestAnimationFrame(() => {
          document.documentElement.classList.add('theme-transitions');
        });
      }

      if (document.readyState !== 'loading') {
        onPageReady();
      } else {
        document.addEventListener('DOMContentLoaded', onPageReady, {
          once: true,
        });
      }
    </script>
  </body>
</html>
