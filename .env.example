# Neon Postgres connection string.
# Neon console (https://console.neon.tech) → your project → "Connection string".
# Use the pooled connection string if offered.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Password for the admin portal at /admin. Pick something long and random.
ADMIN_PASSWORD=change-me

# Optional: secret used to sign admin session cookies. If unset, it is
# derived from ADMIN_PASSWORD (changing the password then logs everyone out).
# SESSION_SECRET=
