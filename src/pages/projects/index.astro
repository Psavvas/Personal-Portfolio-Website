---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatProjectYear,
  getProjectDestination,
  getPublishedProjects,
} from '../../lib/notion-projects';

const pageTitle = 'Projects | Paul Savvas';
const pageDesc =
  'Projects by Paul Savvas — a selection of work across software, hardware, and 3D design.';

const ghProfileUrl = 'https://github.com/psavvas';
const tvProfileUrl = 'https://www.thingiverse.com/psavvas';
const projects = await getPublishedProjects();
const featuredItems = projects.filter((project) => project.featured);

const criteria = [
  {
    title: 'Clarity',
    description: 'Can someone understand the goal and approach quickly?',
  },
  {
    title: 'Constraints',
    description:
      'Does it work within real limits — time, materials, performance?',
  },
  {
    title: 'Results',
    description: 'Are outcomes measurable, testable, and repeatable?',
  },
  {
    title: 'Iteration',
    description: 'What changed after the first version shipped?',
  },
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="mx-auto w-full max-w-6xl px-6 pt-32 pb-24 sm:px-10 sm:pt-36">
    {/* ── Header ── */}
    <header class="max-w-3xl" data-reveal>
      <p class="eyebrow">Projects</p>
      <h1 class="display mt-4 text-4xl sm:text-6xl">
        Simple. Practical. <span class="text-gradient">Impactful.</span>
      </h1>
      <p class="mt-6 text-base leading-8 text-ink-secondary sm:text-lg">
        A growing collection of software, hardware, and 3D design work. I'm
        drawn to projects that can have a positive impact on the world — whether
        in small, everyday ways or larger initiatives — while staying grounded
        in real constraints and performing well in practice.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="btn btn-secondary"
          href={ghProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Code on GitHub
        </a>
        <a
          class="btn btn-secondary"
          href={tvProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          3D designs on Thingiverse
        </a>
      </div>
    </header>

    {/* ── Featured ── */}
    <section class="mt-20">
      <div data-reveal>
        <h2 class="display text-2xl sm:text-3xl">Featured.</h2>
        <p class="mt-3 text-sm leading-6 text-ink-tertiary">
          A few of my most impactful, noteworthy, or favorite projects.
        </p>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          featuredItems.map((project, index) => {
            const destination = getProjectDestination(project);
            const year = formatProjectYear(project.year);
            const card = (
              <>
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-xl font-semibold tracking-tight text-ink">
                    {project.title}
                  </h3>
                  {year && <span class="chip chip--outline">{year}</span>}
                </div>
                <p class="mt-3 text-[0.95rem] leading-7 text-ink-secondary">
                  {project.summary}
                </p>
                <div class="mt-auto flex items-center justify-between gap-3 pt-6">
                  <div class="flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <span class="chip">{tag}</span>
                    ))}
                  </div>
                  {destination && (
                    <span
                      class="shrink-0 text-sm font-medium text-accent transition-transform duration-300 group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      {destination.external ? '↗' : '→'}
                    </span>
                  )}
                </div>
              </>
            );

            return (
              <div data-reveal style={`--reveal-delay: ${(index % 2) * 100}ms`}>
                {destination ? (
                  <a
                    class="card card-interactive group flex h-full flex-col p-7 no-underline sm:p-8"
                    href={destination.url}
                    {...(destination.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {card}
                  </a>
                ) : (
                  <div class="card flex h-full flex-col p-7 sm:p-8">{card}</div>
                )}
              </div>
            );
          })
        }
      </div>
    </section>

    {/* ── Evaluation criteria ── */}
    <section class="mt-20">
      <div data-reveal>
        <h2 class="display text-2xl sm:text-3xl">How I evaluate a project.</h2>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          criteria.map((criterion, index) => (
            <div data-reveal style={`--reveal-delay: ${index * 80}ms`}>
              <div class="card h-full p-6">
                <p class="text-sm font-semibold text-gradient">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-3 text-base font-semibold tracking-tight text-ink">
                  {criterion.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-secondary">
                  {criterion.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* ── All projects ── */}
    <section class="mt-20">
      <div data-reveal>
        <h2 class="display text-2xl sm:text-3xl">All projects.</h2>
        <p class="mt-3 text-sm leading-6 text-ink-tertiary">
          The complete list — or press
          <kbd
            class="mx-1 rounded-md border border-hairline bg-subtle px-1.5 py-0.5 text-xs"
            data-kbd-hint>⌘K</kbd
          >
          to search everything.
        </p>
      </div>

      <div class="card mt-8 overflow-hidden" data-reveal>
        <ul class="divide-y divide-hairline">
          {
            projects.map((project) => {
              const destination = getProjectDestination(project);
              const year = formatProjectYear(project.year);
              const row = (
                <>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="text-[0.95rem] font-semibold tracking-tight text-ink">
                        {project.title}
                      </span>
                      {year && (
                        <span class="text-xs text-ink-tertiary">{year}</span>
                      )}
                    </div>
                    <p class="mt-1 line-clamp-2 text-sm leading-6 text-ink-secondary">
                      {project.summary}
                    </p>
                    <div class="mt-2.5 flex flex-wrap gap-2">
                      {project.tags.map((tag) => (
                        <span class="chip">{tag}</span>
                      ))}
                    </div>
                  </div>
                  {destination && (
                    <span
                      class="mt-1 shrink-0 text-ink-tertiary transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent"
                      aria-hidden="true"
                    >
                      {destination.external ? (
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          class="h-4 w-4"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M7 17 17 7m0 0H9m8 0v8"
                          />
                        </svg>
                      ) : (
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          class="h-4 w-4"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m9 18 6-6-6-6"
                          />
                        </svg>
                      )}
                    </span>
                  )}
                </>
              );

              return (
                <li>
                  {destination ? (
                    <a
                      class="group flex items-start gap-4 p-5 no-underline transition-colors hover:bg-subtle sm:p-6"
                      href={destination.url}
                      {...(destination.external
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      {row}
                    </a>
                  ) : (
                    <div class="flex items-start gap-4 p-5 sm:p-6">{row}</div>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
