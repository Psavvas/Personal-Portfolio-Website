---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Paul Savvas">
  <div
    class="mx-auto flex min-h-[88svh] w-full max-w-4xl flex-col items-center justify-center px-6 pt-32 pb-24 text-center sm:px-10"
  >
    <p
      class="text-gradient text-[clamp(5rem,18vw,9rem)] leading-none font-bold tracking-tight"
      data-reveal
    >
      404
    </p>
    <h1
      class="display mt-4 text-3xl sm:text-4xl"
      data-reveal
      style="--reveal-delay: 80ms"
    >
      Page not found.
    </h1>
    <p
      class="mt-5 max-w-xl text-base leading-8 text-ink-secondary"
      data-reveal
      style="--reveal-delay: 160ms"
    >
      Looks like this route is still in prototype mode. Explore my projects or
      blog while this one is on the workbench.
    </p>

    <div
      class="mt-9 flex flex-wrap justify-center gap-3"
      data-reveal
      style="--reveal-delay: 240ms"
    >
      <a class="btn btn-primary" href="/">Return home</a>
      <a class="btn btn-secondary" href="/projects">View projects</a>
      <a class="btn btn-secondary" href="/blog">Visit blog</a>
    </div>
  </div>
</BaseLayout>
