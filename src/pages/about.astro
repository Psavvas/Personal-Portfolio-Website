---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNowSectionHtml } from '../lib/notion-now';

const pageTitle = 'About | Paul Savvas';
const pageDesc =
  'About Paul Savvas, student engineer building practical tools across software, hardware, and 3D design.';

const btnClasses =
  'site-btn hover-lift';

const values = [
  {
    name: 'Simplicity:',
    desc: 'reduce complexity until the system is easy to understand.',
  },
  {
    name: 'Durability:',
    desc: 'build things that keep working when conditions change.',
  },
  {
    name: 'Useful output:',
    desc: 'ship tools that solve real problems and improve over time.',
  },
  {
    name: 'Good communication:',
    desc: 'document decisions and make the work easy to collaborate on.',
  },
  {
    name: 'Learning from failure:',
    desc: 'treat setbacks as feedback and use them to refine the approach.',
  },
];

const domains = [
  'Software: small products, utilities, and experiments that are fast to iterate and easy to maintain.',
  'Hardware: practical builds where constraints (power, sensors, materials) shape the solution.',
  '3D design: parts and prototypes that are tested, adjusted, and refined in real conditions.',
];

const fallbackNowHtml = `
  <p>
    Right now, I'm focused on building a platform that redefines how independent learners connect, collaborate, and teach one another. I can't share too many details yet, but the goal is to make peer learning more accessible and effective. I'll share more as the project is finalized, and I hope to announce it publicly by August 2026.
  </p>
  <p>
    If you want to see what I'm working on, the best place to start is my GitHub or Thingiverse.
  </p>
`;

const nowHtml = await getNowSectionHtml();
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div
    class="min-h-screen bg-white font-sans dark:bg-neutral-950 transition-colors"
  >
    <main
      class="mx-auto w-full max-w-6xl bg-white px-6 py-16 dark:bg-neutral-950 sm:px-16 sm:py-24 animate-fade-in"
    >
      <header class="w-full animate-fade-in-up">
        <p
          class="text-sm font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400"
        >
          About
        </p>
        <h1
          class="mt-3 text-4xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-5xl"
        >
          Building practical tools, thoughtfully.
        </h1>
        <p
          class="mt-6 text-base leading-7 text-neutral-700 dark:text-neutral-300"
        >
          I'm Paul Savvas, a student at the SMCPS STEM Academy (Grade 10) who
          enjoys turning ideas into real, working things. I like projects where
          engineering and design meet: clear constraints, measurable results,
          and details that hold up outside a demo.
        </p>
        <p
          class="mt-4 text-base leading-7 text-neutral-700 dark:text-neutral-300"
        >
          Most of my projects start with failure: circuits that don't work,
          code that breaks, prints that warp. I treat those setbacks as data:
          they show what needs fixing. Through CAD design, programming, and
          hardware builds, I've learned that progress comes from testing
          assumptions early and iterating until the solution works reliably.
        </p>
        <p
          class="mt-4 text-base leading-7 text-neutral-700 dark:text-neutral-300"
        >
          Alongside my projects, I maintain straight A's at the STEM Academy and
          look for opportunities to help classmates work through technical
          problems. Leadership, for me, means making sure the people around you
          have what they need to improve, whether that's clearer documentation,
          a second perspective, or just accountability to keep moving forward.
        </p>
      </header>

      <!-- Two-column cards -->
      <section class="mt-14 grid gap-10 md:grid-cols-2">
        <div
          class="rounded-xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-950 hover-lift animate-fade-in-up"
        >
          <h2
            class="text-lg font-semibold text-neutral-900 dark:text-neutral-100"
          >
            What I care about
          </h2>
          <ul
            class="mt-4 space-y-3 text-sm leading-6 text-neutral-700 dark:text-neutral-300"
          >
            {
              values.map((v) => (
                <li>
                  <span class="font-medium text-neutral-900 dark:text-neutral-100">
                    {v.name}
                  </span>{' '}
                  {v.desc}
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="rounded-xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-950 hover-lift animate-fade-in-up"
        >
          <h2
            class="text-lg font-semibold text-neutral-900 dark:text-neutral-100"
          >
            What I work on
          </h2>
          <ul
            class="mt-4 space-y-3 text-sm leading-6 text-neutral-700 dark:text-neutral-300"
          >
            {domains.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </section>

      <!-- Now section -->
      <section class="mt-14 w-full animate-fade-in-up animation-delay-300">
        <h2
          class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
        >
          Now
        </h2>
        <div
          class="mt-4 space-y-4 text-base leading-7 text-neutral-700 dark:text-neutral-300"
          set:html={nowHtml || fallbackNowHtml}
        />
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            class={btnClasses}
            href="https://github.com/psavvas"
            target="_blank"
            rel="noopener noreferrer">Visit GitHub</a
          >
          <a
            class={btnClasses}
            href="https://www.thingiverse.com/psavvas/"
            target="_blank"
            rel="noopener noreferrer">Visit Thingiverse</a
          >
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
