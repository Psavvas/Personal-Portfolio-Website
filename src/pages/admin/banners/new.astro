---
import BannerForm from '../../../components/admin/BannerForm.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  friendlyDbError,
  parseBannerForm,
  readBannerForm,
} from '../../../lib/admin-forms';
import { adminCreateBanner, type BannerInput } from '../../../lib/banners';
import { getSitePageGroups } from '../../../lib/site-pages';

// Defence in depth: /admin is gated in src/middleware.ts, and again here so
// that no page is one middleware mistake away from being public.
if (!Astro.locals.admin) return Astro.redirect('/admin/login');

let error = '';
let values: Partial<BannerInput> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    const input = parseBannerForm(form);
    values = input;
    await adminCreateBanner(input);
    return Astro.redirect('/admin/banners?saved=1');
  } catch (err) {
    error = friendlyDbError(err);
    values = readBannerForm(form);
  }
}

const pageGroups = await getSitePageGroups();
---

<AdminLayout title="New banner">
  <header>
    <a
      href="/admin/banners"
      class="text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
    >
      ← Back to banners
    </a>
    <h1
      class="mt-3 text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
    >
      New banner
    </h1>
  </header>

  {
    error && (
      <div class="mt-6 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
        {error}
      </div>
    )
  }

  <div class="mt-8">
    <BannerForm
      values={values}
      pageGroups={pageGroups}
      submitLabel="Create banner"
    />
  </div>
</AdminLayout>
