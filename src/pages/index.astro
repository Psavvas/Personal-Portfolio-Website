---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getLatestProject,
  getProjectDestination,
  getPublishedProjects,
} from '../lib/notion-projects';
import { getPublishedBlogPosts } from '../lib/notion-blog';
import { formatDate } from '../lib/format';

const projects = await getPublishedProjects();
const blogPosts = await getPublishedBlogPosts();

const latestProject = getLatestProject(projects);
const latestProjectDest = latestProject
  ? getProjectDestination(latestProject)
  : null;
const latestPost = blogPosts[0];
const projectCount = projects.length;
const blogCount = blogPosts.length;

const socials = [
  { label: 'GitHub', href: 'https://github.com/psavvas' },
  { label: 'Thingiverse', href: 'https://www.thingiverse.com/psavvas' },
  { label: 'Gravatar', href: 'https://gravatar.com/psavvas' },
];

const stats = [
  {
    label: 'Projects',
    value: String(projectCount),
    detail: projectCount === 1 ? 'project shipped' : 'projects shipped',
    href: '/projects',
  },
  {
    label: 'Blog posts',
    value: String(blogCount),
    detail: blogCount === 1 ? 'post published' : 'posts published',
    href: '/blog',
  },
  {
    label: 'School',
    value: 'GMHS',
    detail: 'STEM Academy · Grade 10',
  },
  {
    label: 'Location',
    value: 'Maryland',
    detail: 'United States',
  },
];

const disciplines = [
  {
    title: 'Software',
    description:
      'Small products, utilities, and experiments that are fast to iterate and easy to maintain.',
    icon: 'M6.75 7.5 3 11.25l3.75 3.75m10.5-7.5 3.75 3.75-3.75 3.75M14.25 4.5l-4.5 15',
  },
  {
    title: 'Hardware',
    description:
      'Practical builds where constraints — power, sensors, materials — shape the solution.',
    icon: 'M8.25 3v2.25M15.75 3v2.25M8.25 18.75V21M15.75 18.75V21M3 8.25h2.25M3 15.75h2.25M18.75 8.25H21M18.75 15.75H21M7.5 5.25h9A2.25 2.25 0 0 1 18.75 7.5v9a2.25 2.25 0 0 1-2.25 2.25h-9A2.25 2.25 0 0 1 5.25 16.5v-9A2.25 2.25 0 0 1 7.5 5.25Zm2.25 4.5h4.5v4.5h-4.5v-4.5Z',
  },
  {
    title: '3D Design',
    description:
      'Parts and prototypes that are tested, adjusted, and refined in real conditions.',
    icon: 'm21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9',
  },
];
---

<BaseLayout
  title="Paul Savvas"
  description="Paul Savvas, student engineer who builds practical tools across software, hardware, and 3D design."
>
  <div class="overflow-x-clip">
    {/* ── Hero ── */}
    <section
      class="relative mx-auto flex min-h-[92svh] w-full max-w-5xl flex-col items-center justify-center px-6 pt-36 pb-16 text-center sm:pt-40"
    >
      <div data-reveal>
        <a
          id="home-status-pill"
          class="status-pill"
          data-status="UP"
          href="https://paulsavvas.instatus.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open site status page"
        >
          <span class="status-dot" aria-hidden="true"></span>
          <span data-status-label>All systems live</span>
        </a>
      </div>

      <h1
        class="display mt-8 text-[clamp(3rem,9vw,5.5rem)]"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        Paul Savvas
      </h1>

      <p
        class="mt-5 max-w-3xl text-[clamp(1.35rem,3.4vw,2.1rem)] leading-[1.2] font-semibold tracking-tight text-ink"
        data-reveal
        style="--reveal-delay: 160ms"
      >
        Building <span class="text-gradient">practical tools</span> across software,
        hardware, and 3D&nbsp;design.
      </p>

      <p
        class="mt-7 max-w-2xl text-base leading-8 text-ink-secondary sm:text-lg"
        data-reveal
        style="--reveal-delay: 240ms"
      >
        I'm a STEM Academy student who combines engineering, design, and systems
        thinking to create solutions that are clear, durable, and genuinely
        useful — tested in real conditions and refined until they hold up beyond
        the classroom.
      </p>

      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-3"
        data-reveal
        style="--reveal-delay: 320ms"
      >
        <a class="btn btn-primary" href="/projects">
          Explore projects
          <svg
            class="btn-arrow"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14m0 0-5-5m5 5-5 5"></path>
          </svg>
        </a>
        <a class="btn btn-secondary" href="/blog">Read the blog</a>
      </div>

      <div
        class="mt-9 flex flex-wrap items-center justify-center gap-2"
        data-reveal
        style="--reveal-delay: 400ms"
      >
        {
          socials.map((social) => (
            <a
              class="btn btn-ghost btn--sm"
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {social.label}
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="h-3 w-3 opacity-50"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7 17 17 7m0 0H9m8 0v8"
                />
              </svg>
            </a>
          ))
        }
      </div>
    </section>

    {/* ── Stats ── */}
    <section class="mx-auto w-full max-w-6xl px-6 pb-10 sm:px-10">
      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {
          stats.map((stat, index) => {
            const inner = (
              <>
                <p class="eyebrow">{stat.label}</p>
                <p class="mt-3 text-3xl font-semibold tracking-tight text-ink">
                  {stat.value}
                </p>
                <p class="mt-1 text-sm text-ink-tertiary">{stat.detail}</p>
              </>
            );
            return (
              <div data-reveal style={`--reveal-delay: ${index * 80}ms`}>
                {stat.href ? (
                  <a
                    href={stat.href}
                    class="card card-interactive block p-6 no-underline"
                  >
                    {inner}
                  </a>
                ) : (
                  <div class="card p-6">{inner}</div>
                )}
              </div>
            );
          })
        }
      </div>
    </section>

    {/* ── Latest work ── */}
    <section class="mx-auto w-full max-w-6xl px-6 py-16 sm:px-10">
      <div class="flex items-end justify-between gap-4" data-reveal>
        <h2 class="display text-3xl sm:text-4xl">The latest.</h2>
        <a
          href="/projects"
          class="hidden text-sm font-medium text-accent hover:underline sm:block"
        >
          View all projects →
        </a>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          latestProject && (
            <div data-reveal>
              <a
                class="card card-interactive group flex h-full flex-col p-7 no-underline sm:p-8"
                href={latestProjectDest?.url ?? '/projects'}
                {...(latestProjectDest?.external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                <p class="eyebrow">Latest project</p>
                <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
                  {latestProject.title}
                </h3>
                <p class="mt-3 line-clamp-3 text-[0.95rem] leading-7 text-ink-secondary">
                  {latestProject.summary}
                </p>
                <div class="mt-auto flex items-center justify-between pt-6">
                  <div class="flex flex-wrap gap-2">
                    {latestProject.tags.slice(0, 3).map((tag) => (
                      <span class="chip">{tag}</span>
                    ))}
                  </div>
                  <span
                    class="text-accent transition-transform duration-300 group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </div>
              </a>
            </div>
          )
        }

        {
          latestPost && (
            <div data-reveal style="--reveal-delay: 100ms">
              <a
                class="card card-interactive group flex h-full flex-col p-7 no-underline sm:p-8"
                href={`/blog/${latestPost.slug}`}
              >
                <p class="eyebrow">Latest blog post</p>
                <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
                  {latestPost.title}
                </h3>
                <p class="mt-3 line-clamp-3 text-[0.95rem] leading-7 text-ink-secondary">
                  {latestPost.summary}
                </p>
                <div class="mt-auto flex items-center justify-between pt-6">
                  <span class="text-sm text-ink-tertiary">
                    {formatDate(latestPost.date)}
                  </span>
                  <span
                    class="text-accent transition-transform duration-300 group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </div>
              </a>
            </div>
          )
        }
      </div>
    </section>

    {/* ── Disciplines ── */}
    <section class="mx-auto w-full max-w-6xl px-6 py-16 sm:px-10">
      <div class="max-w-2xl" data-reveal>
        <h2 class="display text-3xl sm:text-4xl">
          Three disciplines. One approach.
        </h2>
        <p class="mt-4 text-base leading-7 text-ink-secondary">
          I value simplicity, structure, and impact — and aim to ship tools that
          solve real problems and improve over time.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          disciplines.map((discipline, index) => (
            <div data-reveal style={`--reveal-delay: ${index * 100}ms`}>
              <div class="card card-interactive h-full p-7">
                <span
                  class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-hairline bg-subtle text-ink"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    class="h-5 w-5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={discipline.icon}
                    />
                  </svg>
                </span>
                <h3 class="mt-5 text-lg font-semibold tracking-tight text-ink">
                  {discipline.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-secondary">
                  {discipline.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* ── CTA ── */}
    <section class="mx-auto w-full max-w-4xl px-6 py-24 text-center sm:px-10">
      <div data-reveal>
        <h2 class="display text-3xl sm:text-5xl">
          Have an idea <span class="text-gradient">worth building?</span>
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-ink-secondary">
          I'm always interested in collaborating, comparing notes, or talking
          through a project. Reach out — I'd love to hear from you.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a class="btn btn-primary" href="/contact">
            Get in touch
            <svg
              class="btn-arrow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12h14m0 0-5-5m5 5-5 5"></path>
            </svg>
          </a>
          <a class="btn btn-secondary" href="/about">More about me</a>
        </div>
      </div>
    </section>
  </div>

  {/* Live status pill — fed by instatus, view-transition safe. */}
  <script>
    const STATUS_LABELS: Record<string, string> = {
      UP: 'All systems live',
      HASISSUES: 'Experiencing issues',
      UNDERMAINTENANCE: 'Under maintenance',
      DOWN: 'Service outage',
    };

    async function initHomeStatusPill() {
      const pill = document.getElementById('home-status-pill');
      if (!pill || pill.dataset.statusLoaded) return;
      pill.dataset.statusLoaded = '1';

      try {
        const response = await fetch(
          'https://paulsavvas.instatus.com/summary.json',
          { cache: 'no-store' }
        );
        if (!response.ok) return;

        const data = await response.json();
        const status = String(data?.page?.status ?? '').toUpperCase();
        const label = STATUS_LABELS[status];
        if (!label) return;

        pill.dataset.status = status;
        const labelEl = pill.querySelector('[data-status-label]');
        if (labelEl) labelEl.textContent = label;
      } catch {
        /* Keep the default state when the status service is unreachable. */
      }
    }

    document.addEventListener('astro:page-load', initHomeStatusPill);
    if (document.readyState !== 'loading') {
      initHomeStatusPill();
    } else {
      document.addEventListener('DOMContentLoaded', initHomeStatusPill, {
        once: true,
      });
    }
  </script>
</BaseLayout>
