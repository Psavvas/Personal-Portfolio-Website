---
// Universal search (⌘K command palette). Searches pages, projects, and
// blog posts using the build-time index at /search-index.json.
---

<div
  id="cmdk"
  class="cmdk"
  role="dialog"
  aria-modal="true"
  aria-label="Search the site"
  hidden
>
  <div class="cmdk-backdrop" data-cmdk-close></div>
  <div class="cmdk-panel">
    <div class="cmdk-input-row">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
        ></path>
      </svg>
      <input
        id="cmdk-input"
        class="cmdk-input"
        type="text"
        placeholder="Search projects, posts, pages…"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-results"
        aria-autocomplete="list"
      />
      <kbd class="cmdk-esc" data-cmdk-close>esc</kbd>
    </div>
    <div id="cmdk-results" class="cmdk-results" role="listbox"></div>
    <div class="cmdk-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
      <span><kbd>↵</kbd> Open</span>
      <span><kbd>esc</kbd> Close</span>
    </div>
  </div>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  interface SearchItem {
    type: 'page' | 'project' | 'blog';
    title: string;
    description: string;
    url: string;
    external: boolean;
    tags: string[];
    meta: string;
  }

  const GROUP_LABELS: Record<string, string> = {
    page: 'Pages',
    project: 'Projects',
    blog: 'Blog posts',
  };

  const GROUP_ORDER = ['page', 'project', 'blog'];

  const TYPE_ICONS: Record<string, string> = {
    page: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.75 12 4.5l8.25 5.25M5.25 11.25V19.5h13.5v-8.25"/></svg>',
    project:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5 12 3l9 4.5-9 4.5-9-4.5Zm0 4.5 9 4.5 9-4.5M3 16.5 12 21l9-4.5"/></svg>',
    blog: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 18V6A1.5 1.5 0 0 1 5 4.5Zm3 4h8m-8 4h8m-8 4h5"/></svg>',
  };

  const EXTERNAL_ICON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0H9m8 0v8"/></svg>';

  let indexPromise: Promise<SearchItem[]> | null = null;
  let visibleItems: SearchItem[] = [];
  let activeIndex = 0;

  function loadIndex(): Promise<SearchItem[]> {
    if (!indexPromise) {
      indexPromise = fetch('/search-index.json')
        .then((response) => {
          if (!response.ok) throw new Error('Search index unavailable');
          return response.json();
        })
        .then((data) => (data.items ?? []) as SearchItem[])
        .catch(() => {
          indexPromise = null;
          return [];
        });
    }
    return indexPromise;
  }

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  /* Score a candidate against the query: exact substring matches rank
     highest (earlier and on the title is better), then fall back to an
     in-order character subsequence match. Returns -1 for no match. */
  function scoreText(query: string, text: string): number {
    const haystack = text.toLowerCase();
    const index = haystack.indexOf(query);
    if (index === 0) return 100;
    if (index > 0) return 70 - Math.min(index, 30);

    let qi = 0;
    for (let i = 0; i < haystack.length && qi < query.length; i++) {
      if (haystack[i] === query[qi]) qi++;
    }
    return qi === query.length ? 20 : -1;
  }

  function scoreItem(query: string, item: SearchItem): number {
    const titleScore = scoreText(query, item.title);
    const tagScore = item.tags.length
      ? scoreText(query, item.tags.join(' '))
      : -1;
    const descScore = scoreText(query, item.description);

    let best = -1;
    if (titleScore >= 0) best = Math.max(best, titleScore * 3);
    if (tagScore >= 0) best = Math.max(best, tagScore * 1.5);
    if (descScore >= 0) best = Math.max(best, descScore);
    return best;
  }

  function highlight(title: string, query: string): string {
    if (!query) return escapeHtml(title);
    const index = title.toLowerCase().indexOf(query);
    if (index < 0) return escapeHtml(title);
    return (
      escapeHtml(title.slice(0, index)) +
      '<mark>' +
      escapeHtml(title.slice(index, index + query.length)) +
      '</mark>' +
      escapeHtml(title.slice(index + query.length))
    );
  }

  function renderResults(items: SearchItem[], query: string) {
    const container = document.getElementById('cmdk-results');
    if (!container) return;

    visibleItems = items;
    activeIndex = 0;

    if (items.length === 0) {
      container.innerHTML = `<div class="cmdk-empty">No results for “${escapeHtml(query)}”</div>`;
      return;
    }

    let html = '';
    for (const group of GROUP_ORDER) {
      const groupItems = items.filter((item) => item.type === group);
      if (groupItems.length === 0) continue;

      html += `<div class="cmdk-group-label">${GROUP_LABELS[group]}</div>`;
      for (const item of groupItems) {
        const flatIndex = items.indexOf(item);
        const metaContent = item.external
          ? EXTERNAL_ICON
          : escapeHtml(item.meta);
        html += `
          <a
            class="cmdk-item"
            role="option"
            id="cmdk-option-${flatIndex}"
            aria-selected="${flatIndex === 0 ? 'true' : 'false'}"
            data-cmdk-index="${flatIndex}"
            href="${escapeHtml(item.url)}"
            ${item.external ? 'target="_blank" rel="noopener noreferrer"' : ''}
          >
            <span class="cmdk-item-icon">${TYPE_ICONS[item.type]}</span>
            <span class="cmdk-item-body">
              <span class="cmdk-item-title">${highlight(item.title, query)}</span>
              ${item.description ? `<span class="cmdk-item-desc">${escapeHtml(item.description)}</span>` : ''}
            </span>
            <span class="cmdk-item-meta">${metaContent}</span>
          </a>`;
      }
    }
    container.innerHTML = html;
  }

  function setActive(index: number) {
    if (visibleItems.length === 0) return;
    activeIndex = (index + visibleItems.length) % visibleItems.length;

    document.querySelectorAll<HTMLElement>('.cmdk-item').forEach((element) => {
      const isActive = Number(element.dataset.cmdkIndex) === activeIndex;
      element.setAttribute('aria-selected', String(isActive));
      if (isActive) element.scrollIntoView({ block: 'nearest' });
    });

    const input = document.getElementById('cmdk-input');
    input?.setAttribute('aria-activedescendant', `cmdk-option-${activeIndex}`);
  }

  async function runSearch(rawQuery: string) {
    const items = await loadIndex();
    const query = rawQuery.trim().toLowerCase();

    if (!query) {
      // Empty query: quick links — pages first, then recent work.
      const pages = items.filter((item) => item.type === 'page');
      const projects = items
        .filter((item) => item.type === 'project')
        .slice(0, 5);
      const posts = items.filter((item) => item.type === 'blog').slice(0, 4);
      renderResults([...pages, ...projects, ...posts], '');
      return;
    }

    const scored = items
      .map((item) => ({ item, score: scoreItem(query, item) }))
      .filter((entry) => entry.score >= 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 16)
      .map((entry) => entry.item);

    renderResults(scored, query);
  }

  function getPalette() {
    return document.getElementById('cmdk');
  }

  function isOpen() {
    return getPalette()?.classList.contains('is-open') ?? false;
  }

  function openPalette() {
    const palette = getPalette();
    if (!palette || isOpen()) return;

    palette.hidden = false;
    document.documentElement.classList.add('cmdk-lock');
    window.requestAnimationFrame(() => palette.classList.add('is-open'));

    const input = palette.querySelector<HTMLInputElement>('#cmdk-input');
    if (input) {
      input.value = '';
      input.focus();
    }
    runSearch('');
  }

  function closePalette() {
    const palette = getPalette();
    if (!palette || !isOpen()) return;

    palette.classList.remove('is-open');
    document.documentElement.classList.remove('cmdk-lock');
    window.setTimeout(() => {
      palette.hidden = true;
    }, 250);
  }

  function activateItem(item: SearchItem) {
    closePalette();
    if (item.external) {
      window.open(item.url, '_blank', 'noopener,noreferrer');
    } else {
      navigate(item.url);
    }
  }

  function isTypingTarget(target: EventTarget | null): boolean {
    const el = target as HTMLElement | null;
    if (!el) return false;
    return (
      el.tagName === 'INPUT' ||
      el.tagName === 'TEXTAREA' ||
      el.isContentEditable
    );
  }

  if (!(window as any).__psCmdkBound) {
    (window as any).__psCmdkBound = true;

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      if (target.closest('[data-search-open]')) {
        openPalette();
        return;
      }

      if (target.closest('[data-cmdk-close]')) {
        closePalette();
        return;
      }

      const itemLink = target.closest<HTMLElement>('.cmdk-item');
      if (itemLink) {
        event.preventDefault();
        const item = visibleItems[Number(itemLink.dataset.cmdkIndex)];
        if (item) activateItem(item);
      }
    });

    document.addEventListener('mousemove', (event) => {
      const itemLink = (event.target as HTMLElement).closest<HTMLElement>(
        '.cmdk-item'
      );
      if (itemLink && isOpen()) {
        const index = Number(itemLink.dataset.cmdkIndex);
        if (index !== activeIndex) setActive(index);
      }
    });

    document.addEventListener('input', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.id === 'cmdk-input') runSearch(input.value);
    });

    document.addEventListener('keydown', (event) => {
      const isMetaK =
        (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';

      if (isMetaK) {
        event.preventDefault();
        isOpen() ? closePalette() : openPalette();
        return;
      }

      if (
        event.key === '/' &&
        !isOpen() &&
        !isTypingTarget(event.target) &&
        !event.metaKey &&
        !event.ctrlKey &&
        !event.altKey
      ) {
        event.preventDefault();
        openPalette();
        return;
      }

      if (!isOpen()) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closePalette();
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const item = visibleItems[activeIndex];
        if (item) activateItem(item);
      }
    });

    // Prefetch the index when the browser is idle so the first open is
    // instant.
    const prefetch = () => loadIndex();
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(prefetch, { timeout: 4000 });
    } else {
      window.setTimeout(prefetch, 2500);
    }
  }
</script>
