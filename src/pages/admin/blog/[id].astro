---
import BlogForm from '../../../components/admin/BlogForm.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  adminGetBlogPost,
  adminUpdateBlogPost,
  type BlogPostInput,
} from '../../../lib/blog';
import {
  friendlyDbError,
  parseBlogPostForm,
  readBlogPostForm,
} from '../../../lib/admin-forms';
import { adminListProjects } from '../../../lib/projects';

const id = Astro.params.id ?? '';
let error = '';
let overrides: Partial<BlogPostInput> | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    const input = parseBlogPostForm(form);
    await adminUpdateBlogPost(id, input);
    return Astro.redirect('/admin/blog?saved=1');
  } catch (err) {
    error = friendlyDbError(err);
    // Keep everything the user just submitted.
    overrides = readBlogPostForm(form);
  }
}

// If the database is unreachable, fall back to the list page, which shows
// setup instructions.
const post = await adminGetBlogPost(id).catch(() => undefined);
if (!post) {
  return Astro.redirect('/admin/blog');
}

const values: Partial<BlogPostInput> = {
  title: post.title,
  slug: post.slug,
  summary: post.summary,
  dateIso: post.dateIso,
  tags: post.tags,
  featuredProjectSlug: post.featuredProjectSlug,
  bodyMd: post.bodyMd,
  visibility: post.visibility,
  ...(overrides ?? {}),
};

const projectSlugs = await adminListProjects()
  .then((projects) =>
    projects
      .filter((project) => Boolean(project.slug))
      .map((project) => project.slug as string)
  )
  .catch(() => [] as string[]);
---

<AdminLayout title={`Edit: ${post.title}`}>
  <header class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <a
        href="/admin/blog"
        class="text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
      >
        ← Back to blog posts
      </a>
      <h1
        class="mt-3 text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        Edit blog post
      </h1>
    </div>
    {
      post.visibility === 'published' && (
        <a
          href={`/blog/${post.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="site-btn site-btn--sm hover-lift"
        >
          View live ↗
        </a>
      )
    }
  </header>

  {
    error && (
      <div class="mt-6 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
        {error}
      </div>
    )
  }

  <div class="mt-8">
    <BlogForm
      values={values}
      projectSlugs={projectSlugs}
      submitLabel="Save changes"
    />
  </div>
</AdminLayout>
