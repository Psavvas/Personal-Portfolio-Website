---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  getAuth,
  getAuthConfigError,
  hasAnyUser,
  isAuthConfigured,
} from '../../lib/auth';

// One-time bootstrap for the single owner account. Closes permanently as soon
// as a user exists, and requires a setup key so the window between deploying
// and creating the account can't be claimed by someone else.

const MIN_PASSWORD_LENGTH = 12;

function getSetupKey(): string {
  return (
    process.env.ADMIN_SETUP_KEY?.trim() ||
    // The password used by the portal before Better Auth — reused so existing
    // deployments need no new environment variable to bootstrap.
    process.env.ADMIN_PASSWORD?.trim() ||
    ''
  );
}

const configured = isAuthConfigured();
const configError = getAuthConfigError();
const setupKey = getSetupKey();

let alreadySetUp = false;
let dbError = '';
if (configured) {
  try {
    alreadySetUp = await hasAnyUser();
  } catch (error) {
    dbError = error instanceof Error ? error.message : String(error);
  }
}

const canSetUp = configured && !alreadySetUp && !dbError && Boolean(setupKey);

let error = '';
let name = '';
let email = '';

if (Astro.request.method === 'POST' && canSetUp) {
  const form = await Astro.request.formData();
  name = String(form.get('name') ?? '').trim();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirmPassword') ?? '');
  const providedKey = String(form.get('setupKey') ?? '');

  if (providedKey !== setupKey) {
    error = 'That setup key is incorrect.';
  } else if (!name) {
    error = 'Please enter your name.';
  } else if (password.length < MIN_PASSWORD_LENGTH) {
    error = `Your password must be at least ${MIN_PASSWORD_LENGTH} characters.`;
  } else if (password !== confirm) {
    error = 'The two passwords do not match.';
  } else {
    try {
      // Server-side call: the public sign-up endpoint is blocked in
      // middleware, and a database hook caps the portal at one account.
      const result = await getAuth().api.signUpEmail({
        body: { name, email, password },
        headers: Astro.request.headers,
        asResponse: true,
      });

      if (result.ok) {
        const redirect = new Response(null, {
          status: 302,
          headers: { Location: '/admin' },
        });
        for (const cookie of result.headers.getSetCookie()) {
          redirect.headers.append('set-cookie', cookie);
        }
        return redirect;
      }

      const body = await result
        .json()
        .catch(() => ({}) as { message?: string });
      error = body.message || 'Could not create the account. Please try again.';
    } catch (err) {
      error = err instanceof Error ? err.message : String(err);
    }
  }
}

const inputCls =
  'mt-1 w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none focus:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100 dark:focus:border-neutral-500';
const labelCls =
  'block text-sm font-medium text-neutral-900 dark:text-neutral-100';
const helpCls = 'mt-1 text-xs text-neutral-500 dark:text-neutral-400';
---

<AdminLayout title="Set up admin account" bare>
  <div class="mx-auto mt-16 w-full max-w-md">
    <div
      class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm dark:border-neutral-800 dark:bg-neutral-900"
    >
      <p
        class="text-sm font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
      >
        Site Admin
      </p>
      <h1
        class="mt-2 text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        Create your account
      </h1>
      <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
        This is a one-time setup. Once your account exists, this page closes for
        good and the portal accepts no further sign-ups.
      </p>

      {
        !configured && (
          <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-200">
            <p class="font-medium">Authentication is not configured yet.</p>
            <p class="mt-1">{configError}</p>
          </div>
        )
      }

      {
        dbError && (
          <div class="mt-4 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
            <p class="font-medium">Could not reach the database.</p>
            <p class="mt-1">{dbError}</p>
            <p class="mt-2">
              Run <code>db/schema.sql</code> in the Neon SQL editor first.
            </p>
          </div>
        )
      }

      {
        alreadySetUp && (
          <div class="mt-4 rounded-lg border border-neutral-300 bg-neutral-50 p-3 text-sm text-neutral-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
            <p class="font-medium">Setup is already complete.</p>
            <p class="mt-2">
              <a href="/admin/login" class="font-medium underline">
                Go to the login page →
              </a>
            </p>
          </div>
        )
      }

      {
        configured && !alreadySetUp && !dbError && !setupKey && (
          <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-200">
            <p class="font-medium">No setup key is configured.</p>
            <p class="mt-1">
              Set <code>ADMIN_SETUP_KEY</code> to any long random string in your
              hosting dashboard, redeploy, then reload this page. It proves
              you're the owner and is only needed once.
            </p>
          </div>
        )
      }

      {
        error && (
          <div class="mt-4 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
            {error}
          </div>
        )
      }

      {
        canSetUp && (
          <form method="post" class="mt-6 space-y-4">
            <div>
              <label for="setupKey" class={labelCls}>
                Setup key
              </label>
              <input
                id="setupKey"
                name="setupKey"
                type="password"
                required
                autocomplete="off"
                class={inputCls}
              />
              <p class={helpCls}>
                Your <code>ADMIN_SETUP_KEY</code> (or the old{' '}
                <code>ADMIN_PASSWORD</code>) environment variable.
              </p>
            </div>

            <div>
              <label for="name" class={labelCls}>
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                value={name}
                autocomplete="name"
                class={inputCls}
              />
            </div>

            <div>
              <label for="email" class={labelCls}>
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                value={email}
                autocomplete="username"
                class={inputCls}
              />
              <p class={helpCls}>You'll sign in with this address.</p>
            </div>

            <div>
              <label for="password" class={labelCls}>
                Password
              </label>
              <input
                id="password"
                name="password"
                type="password"
                required
                minlength={MIN_PASSWORD_LENGTH}
                autocomplete="new-password"
                class={inputCls}
              />
              <p class={helpCls}>At least {MIN_PASSWORD_LENGTH} characters.</p>
            </div>

            <div>
              <label for="confirmPassword" class={labelCls}>
                Confirm password
              </label>
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                required
                minlength={MIN_PASSWORD_LENGTH}
                autocomplete="new-password"
                class={inputCls}
              />
            </div>

            <button
              type="submit"
              class="site-btn hover-lift w-full justify-center"
            >
              Create account
            </button>
          </form>
        )
      }
    </div>

    <p class="mt-6 text-center text-xs text-neutral-500 dark:text-neutral-400">
      <a href="/" class="hover:underline">← Back to paulsavvas.com</a>
    </p>
  </div>
</AdminLayout>
