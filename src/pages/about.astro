---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNowSectionHtml } from '../lib/notion-now';

const pageTitle = 'About | Paul Savvas';
const pageDesc =
  'About Paul Savvas, student engineer building practical tools across software, hardware, and 3D design.';

const values = [
  {
    name: 'Simplicity',
    desc: 'Reduce complexity until the system is easy to understand.',
  },
  {
    name: 'Durability',
    desc: 'Build things that keep working when conditions change.',
  },
  {
    name: 'Useful output',
    desc: 'Ship tools that solve real problems and improve over time.',
  },
  {
    name: 'Good communication',
    desc: 'Document decisions and make the work easy to collaborate on.',
  },
  {
    name: 'Learning from failure',
    desc: 'Treat setbacks as feedback and use them to refine the approach.',
  },
];

const domains = [
  {
    name: 'Software',
    desc: 'Small products, utilities, and experiments that are fast to iterate and easy to maintain.',
  },
  {
    name: 'Hardware',
    desc: 'Practical builds where constraints (power, sensors, materials) shape the solution.',
  },
  {
    name: '3D design',
    desc: 'Parts and prototypes that are tested, adjusted, and refined in real conditions.',
  },
];

const fallbackNowHtml = `
  <p>
    Right now, I'm focused on building a platform that redefines how independent learners connect, collaborate, and teach one another. I can't share too many details yet, but the goal is to make peer learning more accessible and effective. I'll share more as the project is finalized, and I hope to announce it publicly by August 2026.
  </p>
  <p>
    If you want to see what I'm working on, the best place to start is my GitHub or Thingiverse.
  </p>
`;

const nowHtml = await getNowSectionHtml();
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="mx-auto w-full max-w-6xl px-6 pt-32 pb-24 sm:px-10 sm:pt-36">
    {/* ── Header ── */}
    <header class="max-w-3xl" data-reveal>
      <p class="eyebrow">About</p>
      <h1 class="display mt-4 text-4xl sm:text-6xl">
        Building practical tools, <span class="text-gradient"
          >thoughtfully.</span
        >
      </h1>
      <p class="mt-6 text-base leading-8 text-ink-secondary sm:text-lg">
        I'm Paul Savvas, a student at the SMCPS STEM Academy (Grade 10) who
        enjoys turning ideas into real, working things. I like projects where
        engineering and design meet: clear constraints, measurable results, and
        details that hold up outside a demo.
      </p>
      <p class="mt-4 text-base leading-8 text-ink-secondary">
        Most of my projects start with failure: circuits that don't work, code
        that breaks, prints that warp. I treat those setbacks as data — they
        show what needs fixing. Through CAD design, programming, and hardware
        builds, I've learned that progress comes from testing assumptions early
        and iterating until the solution works reliably.
      </p>
      <p class="mt-4 text-base leading-8 text-ink-secondary">
        Alongside my projects, I maintain straight A's at the STEM Academy and
        look for opportunities to help classmates work through technical
        problems. Leadership, for me, means making sure the people around you
        have what they need to improve — whether that's clearer documentation, a
        second perspective, or just accountability to keep moving forward.
      </p>
    </header>

    {/* ── Values + domains ── */}
    <section class="mt-20 grid gap-5 md:grid-cols-2">
      <div data-reveal>
        <div class="card h-full p-7 sm:p-8">
          <h2 class="text-xl font-semibold tracking-tight text-ink">
            What I care about.
          </h2>
          <ul class="mt-6 space-y-5">
            {
              values.map((value) => (
                <li class="flex gap-3.5">
                  <span
                    class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full"
                    style="background: var(--gradient-display);"
                    aria-hidden="true"
                  />
                  <div>
                    <p class="text-sm font-semibold text-ink">{value.name}</p>
                    <p class="mt-0.5 text-sm leading-6 text-ink-secondary">
                      {value.desc}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 100ms">
        <div class="card h-full p-7 sm:p-8">
          <h2 class="text-xl font-semibold tracking-tight text-ink">
            What I work on.
          </h2>
          <ul class="mt-6 space-y-5">
            {
              domains.map((domain) => (
                <li class="flex gap-3.5">
                  <span
                    class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full"
                    style="background: var(--gradient-display);"
                    aria-hidden="true"
                  />
                  <div>
                    <p class="text-sm font-semibold text-ink">{domain.name}</p>
                    <p class="mt-0.5 text-sm leading-6 text-ink-secondary">
                      {domain.desc}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ── Now ── */}
    <section class="mt-20" data-reveal>
      <div class="card p-7 sm:p-10">
        <div class="flex items-center gap-3">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"
            ></span>
            <span
              class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"
            ></span>
          </span>
          <h2 class="display text-2xl sm:text-3xl">Now.</h2>
        </div>
        <div
          class="mt-6 max-w-3xl space-y-4 text-base leading-8 text-ink-secondary [&_a]:font-medium [&_a]:text-accent [&_a:hover]:underline [&_strong]:text-ink"
          set:html={nowHtml || fallbackNowHtml}
        />
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="btn btn-secondary"
            href="https://github.com/psavvas"
            target="_blank"
            rel="noopener noreferrer">Visit GitHub</a
          >
          <a
            class="btn btn-secondary"
            href="https://www.thingiverse.com/psavvas/"
            target="_blank"
            rel="noopener noreferrer">Visit Thingiverse</a
          >
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
