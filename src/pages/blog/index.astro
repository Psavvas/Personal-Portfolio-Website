---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import { getPublishedBlogPosts } from '../../lib/notion-blog';

const pageTitle = 'Blog | Paul Savvas';
const pageDesc =
  'Blog posts by Paul Savvas — project notes, lessons learned, and build write-ups.';

const sortedPosts = await getPublishedBlogPosts();

const tagCls =
  'inline-flex items-center rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700 dark:bg-neutral-900 dark:text-neutral-300';
const btnCls = 'site-btn hover-lift';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div
    class="min-h-screen bg-white font-sans dark:bg-neutral-950 transition-colors"
  >
    <main
      class="mx-auto w-full max-w-6xl bg-white px-6 py-16 dark:bg-neutral-950 sm:px-16 sm:py-24 animate-fade-in"
    >
      <header class="w-full animate-fade-in-up">
        <p
          class="text-sm font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400"
        >
          Blog
        </p>
        <h1
          class="mt-3 text-4xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-5xl"
        >
          Notes and write-ups
        </h1>
        <p
          class="mt-6 text-base leading-7 text-neutral-700 dark:text-neutral-300"
        >
          Short posts about projects, engineering decisions, and what I learn
          while building.
        </p>
      </header>

      <section class="mt-14 w-full">
        {
          sortedPosts.length === 0 ? (
            <div class="rounded-xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-950 hover-lift">
              <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
                Coming soon
              </h2>
              <p class="mt-3 text-sm leading-6 text-neutral-700 dark:text-neutral-300">
                I'm working on the first set of posts now.
              </p>
            </div>
          ) : (
            <div>
              <div class="mb-8 animate-fade-in-up">
                <SearchBar
                  targetId="blog-list"
                  emptyId="blog-empty"
                  countId="blog-count"
                  label="Search blog posts"
                  placeholder="Search posts by title, summary, or tag…"
                />
                <p
                  id="blog-count"
                  class="mt-2 text-xs text-neutral-500 dark:text-neutral-400"
                  aria-live="polite"
                />
              </div>

              <div id="blog-list" class="grid gap-6">
                {sortedPosts.map((post) => (
                  <article
                    data-search={[
                      post.title,
                      post.summary,
                      ...(post.tags ?? []),
                    ]
                      .join(' ')
                      .toLowerCase()}
                    class="rounded-xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-950 hover-lift animate-fade-in-up"
                  >
                    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                      <h2 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
                        <a href={`/blog/${post.slug}`} class="hover:underline">
                          {post.title}
                        </a>
                      </h2>
                      <p class="text-sm text-neutral-600 dark:text-neutral-400">
                        {post.date}
                      </p>
                    </div>

                    <p class="mt-3 text-sm leading-6 text-neutral-700 dark:text-neutral-300">
                      {post.summary}
                    </p>

                    {post.tags && post.tags.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-2">
                        {post.tags.map((t: string) => (
                          <span class={tagCls}>{t}</span>
                        ))}
                      </div>
                    )}

                    <div class="mt-6">
                      <a class={btnCls} href={`/blog/${post.slug}`}>
                        Read post
                      </a>
                    </div>
                  </article>
                ))}
              </div>

              <div
                id="blog-empty"
                class="hidden rounded-xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-950"
              >
                <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
                  No posts found
                </h2>
                <p class="mt-3 text-sm leading-6 text-neutral-700 dark:text-neutral-300">
                  No posts match your search. Try a different keyword.
                </p>
              </div>
            </div>
          )
        }
      </section>
    </main>
  </div>
</BaseLayout>
